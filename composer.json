{
    "name": "alchemy/phraseanet-bundle",
    "description": "Phraseanet API Symfony bundle",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Thibaud Fabre",
            "email": "thibaud@aztech.io"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.5",
        "friendsofphp/proxy-manager-lts": "^1.0",
        "phraseanet/php-sdk": "^8.0",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/http-kernel": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Alchemy\\PhraseanetBundle\\": "src/Bundle",
            "Alchemy\\Phraseanet\\": "src/Component"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    }
}
