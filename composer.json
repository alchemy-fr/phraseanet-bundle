{
    "name": "alchemy/phraseanet-bundle",
    "description": "Phraseanet API Symfony bundle",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Thibaud Fabre",
            "email": "thibaud@aztech.io"
        }
    ],
    "minimum-stability": "dev",
    "repositories": [
        {
            "type": "path",
            "url": "../php-sdk"
        }
    ],
    "require": {
        "ocramius/proxy-manager": "^1.0",
        "phraseanet/php-sdk": "@dev"
    },
    "require-dev": {
        "symfony/symfony": "^2.7",
        "phpunit/phpunit": "^4.8",
        "squizlabs/php_codesniffer": "^2.3",
        "mikey179/vfsstream": "^1.5"
    },
    "autoload": {
        "psr-4": {
            "Alchemy\\PhraseanetBundle\\": "src/Bundle",
            "Alchemy\\Phraseanet\\": "src/Component"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    }
}
